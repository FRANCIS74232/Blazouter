<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Blazouter.Hybrid.Sample.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:Blazouter.Hybrid.Sample.Components"
    xmlns:local="clr-namespace:Blazouter.Hybrid.Sample">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent ComponentType="{x:Type components:Routes}" Selector="#app" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>