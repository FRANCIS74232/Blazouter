@inject RouterNavigationService NavService

<div class="px-4 py-8">
	<!-- Hero Section -->
	<div class="text-center mb-16">
		<div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-blue-500 to-purple-600 rounded-2xl mb-6">
			<span class="text-4xl">🚀</span>
		</div>
		<h1 class="text-5xl font-bold text-gray-900 dark:text-white mb-4">
			Blazouter
		</h1>
		<p class="text-xl text-gray-600 dark:text-gray-300 mb-4">
			A Powerful React Router-Inspired Routing Library for Blazor
		</p>
		<p class="text-gray-600 dark:text-gray-400 max-w-3xl mx-auto mb-8">
			Build sophisticated, feature-rich Blazor applications with enterprise-grade routing capabilities.
			Blazouter brings the best of React Router to the Blazor ecosystem with type-safe APIs and intuitive design.
		</p>
		<div class="flex gap-4 justify-center">
			<button @onclick='@(() => NavService.NavigateTo("/about"))'
					class="px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-all transform hover:scale-105 font-semibold shadow-lg">
				Learn More
			</button>
			<button @onclick='@(() => NavService.NavigateTo("/users"))'
					class="px-8 py-3 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-all transform hover:scale-105 font-semibold">
				View Demos
			</button>
		</div>
	</div>

	<!-- Features Grid -->
	<div class="mb-16">
		<h2 class="text-3xl font-bold text-center text-gray-900 dark:text-white mb-12">
			Comprehensive Feature Set
		</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			<!-- Nested Routes -->
			<div @onclick='@(() => NavService.NavigateTo("/users"))'
				 class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-lg hover:shadow-xl transition-all cursor-pointer transform hover:scale-105 border border-gray-200 dark:border-gray-700">
				<div class="text-4xl mb-4">✅</div>
				<h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Nested Routes</h3>
				<p class="text-gray-600 dark:text-gray-400 mb-4">
					Build complex route hierarchies with parent-child relationships, just like React Router
				</p>
				<span class="text-blue-600 dark:text-blue-400 font-medium">View Demo →</span>
			</div>

			<!-- Route Guards -->
			<div @onclick='@(() => NavService.NavigateTo("/protected"))'
				 class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-lg hover:shadow-xl transition-all cursor-pointer transform hover:scale-105 border border-gray-200 dark:border-gray-700">
				<div class="text-4xl mb-4">🔒</div>
				<h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Route Guards</h3>
				<p class="text-gray-600 dark:text-gray-400 mb-4">
					Protect your routes with powerful authentication and authorization guards
				</p>
				<span class="text-blue-600 dark:text-blue-400 font-medium">View Demo →</span>
			</div>

			<!-- Lazy Loading -->
			<div @onclick='@(() => NavService.NavigateTo("/lazy"))'
				 class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-lg hover:shadow-xl transition-all cursor-pointer transform hover:scale-105 border border-gray-200 dark:border-gray-700">
				<div class="text-4xl mb-4">⚡</div>
				<h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Lazy Loading</h3>
				<p class="text-gray-600 dark:text-gray-400 mb-4">
					Load components on-demand with async component loaders and beautiful loading states
				</p>
				<span class="text-blue-600 dark:text-blue-400 font-medium">View Demo →</span>
			</div>

			<!-- Route Transitions -->
			<div @onclick='@(() => NavService.NavigateTo("/transitions"))'
				 class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-lg hover:shadow-xl transition-all cursor-pointer transform hover:scale-105 border border-gray-200 dark:border-gray-700">
				<div class="text-4xl mb-4">🎨</div>
				<h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Route Transitions</h3>
				<p class="text-gray-600 dark:text-gray-400 mb-4">
					Add smooth animations between route changes with 14 built-in transition types
				</p>
				<span class="text-blue-600 dark:text-blue-400 font-medium">View Demo →</span>
			</div>

			<!-- Dynamic Parameters -->
			<div @onclick='@(() => NavService.NavigateTo("/users/1"))'
				 class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-lg hover:shadow-xl transition-all cursor-pointer transform hover:scale-105 border border-gray-200 dark:border-gray-700">
				<div class="text-4xl mb-4">🎯</div>
				<h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Dynamic Parameters</h3>
				<p class="text-gray-600 dark:text-gray-400 mb-4">
					Easy access to route and query parameters with type-safe APIs
				</p>
				<span class="text-blue-600 dark:text-blue-400 font-medium">View Demo →</span>
			</div>

			<!-- Programmatic Navigation -->
			<div @onclick='@(() => NavService.NavigateTo("/navigation"))'
				 class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-lg hover:shadow-xl transition-all cursor-pointer transform hover:scale-105 border border-gray-200 dark:border-gray-700">
				<div class="text-4xl mb-4">🔗</div>
				<h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Programmatic Navigation</h3>
				<p class="text-gray-600 dark:text-gray-400 mb-4">
					Navigate imperatively with the RouterNavigationService
				</p>
				<span class="text-blue-600 dark:text-blue-400 font-medium">View Demo →</span>
			</div>
		</div>
	</div>

	<!-- Comparison Table -->
	<div class="mb-16">
		<h2 class="text-3xl font-bold text-center text-gray-900 dark:text-white mb-12">
			Why Choose Blazouter?
		</h2>
		<div class="overflow-x-auto">
			<table class="min-w-full bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden">
				<thead class="bg-gray-100 dark:bg-gray-700">
					<tr>
						<th class="px-6 py-4 text-left text-sm font-semibold text-gray-900 dark:text-white">Feature</th>
						<th class="px-6 py-4 text-center text-sm font-semibold text-gray-900 dark:text-white">React Router</th>
						<th class="px-6 py-4 text-center text-sm font-semibold text-gray-900 dark:text-white">Blazor Router</th>
						<th class="px-6 py-4 text-center text-sm font-semibold bg-blue-100 dark:bg-blue-900 text-blue-900 dark:text-blue-100">Blazouter</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
					<tr>
						<td class="px-6 py-4 text-sm text-gray-900 dark:text-white">Nested Routes</td>
						<td class="px-6 py-4 text-center text-2xl">✅</td>
						<td class="px-6 py-4 text-center text-2xl">❌</td>
						<td class="px-6 py-4 text-center text-2xl bg-blue-50 dark:bg-blue-900/20">✅</td>
					</tr>
					<tr>
						<td class="px-6 py-4 text-sm text-gray-900 dark:text-white">Route Guards</td>
						<td class="px-6 py-4 text-center text-2xl">✅</td>
						<td class="px-6 py-4 text-center text-2xl">❌</td>
						<td class="px-6 py-4 text-center text-2xl bg-blue-50 dark:bg-blue-900/20">✅</td>
					</tr>
					<tr>
						<td class="px-6 py-4 text-sm text-gray-900 dark:text-white">Lazy Loading</td>
						<td class="px-6 py-4 text-center text-2xl">✅</td>
						<td class="px-6 py-4 text-center text-2xl">⚠️</td>
						<td class="px-6 py-4 text-center text-2xl bg-blue-50 dark:bg-blue-900/20">✅</td>
					</tr>
					<tr>
						<td class="px-6 py-4 text-sm text-gray-900 dark:text-white">Transitions</td>
						<td class="px-6 py-4 text-center text-2xl">✅</td>
						<td class="px-6 py-4 text-center text-2xl">❌</td>
						<td class="px-6 py-4 text-center text-2xl bg-blue-50 dark:bg-blue-900/20">✅</td>
					</tr>
					<tr>
						<td class="px-6 py-4 text-sm text-gray-900 dark:text-white">Active Links</td>
						<td class="px-6 py-4 text-center text-2xl">✅</td>
						<td class="px-6 py-4 text-center text-2xl">⚠️</td>
						<td class="px-6 py-4 text-center text-2xl bg-blue-50 dark:bg-blue-900/20">✅</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>

	<!-- Quick Start -->
	<div class="max-w-4xl mx-auto">
		<h2 class="text-3xl font-bold text-center text-gray-900 dark:text-white mb-12">
			Quick Start
		</h2>
		<div class="space-y-6">
			<div class="bg-gray-900 dark:bg-gray-950 rounded-xl overflow-hidden shadow-lg">
				<div class="px-4 py-2 bg-gray-800 dark:bg-gray-900 text-gray-300 text-sm font-semibold">
					Program.cs
				</div>
				<pre class="p-4 overflow-x-auto"><code class="text-green-400">builder.Services.AddBlazouter();</code></pre>
			</div>
			<div class="bg-gray-900 dark:bg-gray-950 rounded-xl overflow-hidden shadow-lg">
				<div class="px-4 py-2 bg-gray-800 dark:bg-gray-900 text-gray-300 text-sm font-semibold">
					App.razor
				</div>
				<pre class="p-4 overflow-x-auto text-sm"><code class="text-gray-300">&lt;Router Routes="@@_routes"&gt;
    &lt;NotFound&gt;&lt;h1&gt;404&lt;/h1&gt;&lt;/NotFound&gt;
&lt;/Router&gt;

@@code {
    private List&lt;RouteConfig&gt; _routes = new()
    {
        new RouteConfig {
            Path = "/",
            Component = typeof(Home),
            Transition = RouteTransition.Fade
        }
    };
}</code></pre>
			</div>
		</div>
	</div>
</div>