<div class="max-w-4xl mx-auto px-4 py-8">
	<h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Dynamic Parameters Example</h2>

	<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-6 mb-6">
		<h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Component Configuration</h3>
		<p class="text-gray-600 dark:text-gray-400 mb-4">This page demonstrates dynamic route parameters:</p>

		<div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 font-mono text-sm mb-4">
			<div class="text-green-600 dark:text-green-400">// DynamicParamsExample.razor.cs</div>
			<div class="text-gray-800 dark:text-gray-200">[<span class="text-blue-600 dark:text-blue-400">Route</span>(<span class="text-orange-600 dark:text-orange-400">"/attribute-examples/user/:userId/post/:postId"</span>)]</div>
			<div class="text-gray-800 dark:text-gray-200">[<span class="text-blue-600 dark:text-blue-400">RouteTitle</span>(<span class="text-orange-600 dark:text-orange-400">"Dynamic Params"</span>)]</div>
			<div class="text-gray-800 dark:text-gray-200">[<span class="text-blue-600 dark:text-blue-400">RouteTransition</span>(RouteTransition.<span class="text-purple-600 dark:text-purple-400">Fade</span>)]</div>
		</div>

		<div class="bg-indigo-50 dark:bg-indigo-900/20 border-2 border-indigo-200 dark:border-indigo-800 rounded-lg p-4 mb-4">
			<h4 class="text-lg font-semibold text-indigo-900 dark:text-indigo-100 mb-3">Current Route Parameters:</h4>
			<dl class="space-y-2">
				<div class="flex">
					<dt class="font-semibold text-indigo-700 dark:text-indigo-300 w-32">User ID:</dt>
					<dd class="text-indigo-900 dark:text-indigo-100 font-mono">@UserId</dd>
				</div>
				<div class="flex">
					<dt class="font-semibold text-indigo-700 dark:text-indigo-300 w-32">Post ID:</dt>
					<dd class="text-indigo-900 dark:text-indigo-100 font-mono">@PostId</dd>
				</div>
			</dl>
		</div>

		<h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Try Different Parameters:</h4>
		<div class="flex flex-wrap gap-2">
			<button @onclick='() => NavigateTo("123", "456")'
					class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
				User 123, Post 456
			</button>
			<button @onclick='() => NavigateTo("999", "777")'
					class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors">
				User 999, Post 777
			</button>
			<button @onclick='() => NavigateTo("abc", "xyz")'
					class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg transition-colors">
				User abc, Post xyz
			</button>
		</div>
	</div>

	<div class="bg-blue-50 dark:bg-blue-900/20 border-2 border-blue-200 dark:border-blue-800 rounded-xl p-6">
		<h3 class="text-lg font-semibold text-blue-900 dark:text-blue-100 mb-3">💡 How It Works</h3>
		<ul class="space-y-2 text-blue-800 dark:text-blue-200">
			<li>• Dynamic parameters use <code class="px-2 py-1 bg-blue-100 dark:bg-blue-800 rounded">:paramName</code> syntax in the route path</li>
			<li>• Access parameters via <code class="px-2 py-1 bg-blue-100 dark:bg-blue-800 rounded">RouterStateService.GetParam("paramName")</code></li>
			<li>• Parameters can be strings, numbers, or any value in the URL</li>
		</ul>
	</div>
</div>