@inject RouterStateService RouterState
@inject StorageInterop? StorageInterop
@inject DocumentInterop? DocumentInterop
@inject ViewportInterop? ViewportInterop
@inject ClipboardInterop? ClipboardInterop
@inject NavigationInterop? NavigationInterop

@implements IDisposable

<div class="max-w-4xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6 text-gray-900 dark:text-white">TypeScript Integration Demo</h1>

    <!-- Browser Navigation Section -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl mb-6 border border-gray-200 dark:border-gray-700">
        <div class="p-6">
            <h2 class="text-2xl font-bold mb-2 text-gray-900 dark:text-white">Browser Navigation</h2>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                Using TypeScript-based JavaScript interop for browser History API
            </p>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
                <div class="bg-gray-50 dark:bg-gray-700/50 p-4 rounded-lg border border-gray-200 dark:border-gray-600">
                    <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">History Length</div>
                    <div class="text-2xl font-bold text-gray-900 dark:text-white">@_historyLength</div>
                    <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">Total entries</div>
                </div>

                <div class="bg-gray-50 dark:bg-gray-700/50 p-4 rounded-lg border border-gray-200 dark:border-gray-600">
                    <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Can Go Back</div>
                    <div class="text-2xl font-bold text-gray-900 dark:text-white">@(_canGoBack ? "✓" : "✗")</div>
                    <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">@(_canGoBack ? "History available" : "At start")</div>
                </div>
            </div>

            @if (_isInteropAvailable)
            {
                <div class="flex flex-wrap gap-2">
                    <button class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:bg-gray-400 disabled:cursor-not-allowed transition-colors" 
                            @onclick="HandleGoBack" 
                            disabled="@(!_canGoBack)">
                        <span class="mr-2">←</span> Go Back
                    </button>
                    <button class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors" 
                            @onclick="HandleGoForward">
                        Go Forward <span class="ml-2">→</span>
                    </button>
                    <button class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors" 
                            @onclick="RefreshNavigationState">
                        🔄 Refresh State
                    </button>
                </div>
            }
            else
            {
                <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-600 dark:text-yellow-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span class="text-sm text-yellow-800 dark:text-yellow-200">JavaScript interop not available. Add <code class="bg-yellow-100 dark:bg-yellow-800/50 px-1 rounded">AddBlazouterInterop()</code> in Program.cs</span>
                </div>
            }
        </div>
    </div>

    <!-- Document Manipulation Section -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl mb-6 border border-gray-200 dark:border-gray-700">
        <div class="p-6">
            <h2 class="text-2xl font-bold mb-2 text-gray-900 dark:text-white">Document Manipulation</h2>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                Dynamic title, meta tags, scrolling, and focus management
            </p>

            @if (_isInteropAvailable)
            {
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Page Title
                    </label>
                    <div class="flex gap-2">
                        <input type="text" 
                               @bind="_newTitle" 
                               class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                               placeholder="Enter new title" />
                        <button class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors whitespace-nowrap" 
                                @onclick="UpdateTitle">
                            Set Title
                        </button>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Meta Description
                    </label>
                    <div class="flex gap-2">
                        <input type="text" 
                               @bind="_newDescription" 
                               class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-purple-500 focus:border-transparent" 
                               placeholder="Enter meta description" />
                        <button class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors whitespace-nowrap" 
                                @onclick="UpdateMetaDescription">
                            Set Meta
                        </button>
                    </div>
                </div>

                <div class="border-t border-gray-200 dark:border-gray-700 my-6 pt-6">
                    <h3 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Scrolling & Focus</h3>
                </div>

                <div class="flex flex-wrap gap-2 mb-4">
                    <button class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors" 
                            @onclick="ScrollToTop">
                        ↑ Scroll to Top
                    </button>
                    <button class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors" 
                            @onclick="ScrollToBottom">
                        ↓ Scroll to Bottom
                    </button>
                    <button class="px-4 py-2 bg-cyan-600 text-white rounded-lg hover:bg-cyan-700 transition-colors" 
                            @onclick="FocusTitleInput">
                        Focus Title Input
                    </button>
                </div>

                <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-6 w-6 text-blue-600 dark:text-blue-400 flex-shrink-0" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="text-sm text-blue-800 dark:text-blue-200">Current title: <strong>@_currentTitle</strong></span>
                </div>
            }
            else
            {
                <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-600 dark:text-yellow-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span class="text-sm text-yellow-800 dark:text-yellow-200">Document interop not available. Add <code class="bg-yellow-100 dark:bg-yellow-800/50 px-1 rounded">AddBlazouterInterop()</code> in Program.cs</span>
                </div>
            }
        </div>
    </div>

    <!-- Storage Section -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl mb-6 border border-gray-200 dark:border-gray-700">
        <div class="p-6">
            <h2 class="text-2xl font-bold mb-2 text-gray-900 dark:text-white">Browser Storage</h2>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                LocalStorage and SessionStorage operations with JSON serialization
            </p>

            @if (_isInteropAvailable)
            {
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Storage Key
                    </label>
                    <input type="text" 
                           @bind="_storageKey" 
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent mb-2" 
                           placeholder="Enter key" />
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Storage Value
                    </label>
                    <input type="text" 
                           @bind="_storageValue" 
                           class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-green-500 focus:border-transparent" 
                           placeholder="Enter value" />
                </div>

                <div class="flex flex-wrap gap-2 mb-4">
                    <button class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors" 
                            @onclick="SaveToLocalStorage">
                        💾 Save to LocalStorage
                    </button>
                    <button class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors" 
                            @onclick="LoadFromLocalStorage">
                        📂 Load from LocalStorage
                    </button>
                    <button class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors" 
                            @onclick="RemoveFromLocalStorage">
                        🗑️ Remove
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_retrievedValue))
                {
                    <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-4 mb-4">
                        <div class="text-sm font-medium text-green-800 dark:text-green-200 mb-1">Retrieved Value:</div>
                        <div class="text-sm text-green-700 dark:text-green-300">@_retrievedValue</div>
                    </div>
                }

                @if (_localStorageKeys.Length > 0)
                {
                    <div class="bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg p-4">
                        <div class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">LocalStorage Keys (@_localStorageKeys.Length):</div>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var key in _localStorageKeys)
                            {
                                <span class="px-2 py-1 bg-gray-200 dark:bg-gray-600 text-gray-800 dark:text-gray-200 rounded text-xs">@key</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-600 dark:text-yellow-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span class="text-sm text-yellow-800 dark:text-yellow-200">Storage interop not available. Add <code class="bg-yellow-100 dark:bg-yellow-800/50 px-1 rounded">AddBlazouterInterop()</code> in Program.cs</span>
                </div>
            }
        </div>
    </div>

    <!-- Viewport Section -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl mb-6 border border-gray-200 dark:border-gray-700">
        <div class="p-6">
            <h2 class="text-2xl font-bold mb-2 text-gray-900 dark:text-white">Viewport & Device Info</h2>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                Viewport dimensions, device type, orientation, and fullscreen API
            </p>

            @if (_isInteropAvailable)
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-4">
                    <div class="bg-gray-50 dark:bg-gray-700/50 p-4 rounded-lg border border-gray-200 dark:border-gray-600">
                        <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Viewport Size</div>
                        <div class="text-xl font-bold text-gray-900 dark:text-white">@_viewportWidth × @_viewportHeight</div>
                        <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">pixels</div>
                    </div>

                    <div class="bg-gray-50 dark:bg-gray-700/50 p-4 rounded-lg border border-gray-200 dark:border-gray-600">
                        <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Device Type</div>
                        <div class="text-xl font-bold text-gray-900 dark:text-white">@_deviceType</div>
                        <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">detected</div>
                    </div>

                    <div class="bg-gray-50 dark:bg-gray-700/50 p-4 rounded-lg border border-gray-200 dark:border-gray-600">
                        <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Orientation</div>
                        <div class="text-xl font-bold text-gray-900 dark:text-white">@_orientation</div>
                        <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">@_pixelRatio.ToString("F1")x pixel ratio</div>
                    </div>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors" 
                            @onclick="RefreshViewportState">
                        🔄 Refresh Viewport Info
                    </button>
                    <button class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors" 
                            @onclick="ToggleFullscreen">
                        @(_isFullscreen ? "🗗 Exit Fullscreen" : "🗖 Enter Fullscreen")
                    </button>
                </div>
            }
            else
            {
                <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-600 dark:text-yellow-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span class="text-sm text-yellow-800 dark:text-yellow-200">Viewport interop not available. Add <code class="bg-yellow-100 dark:bg-yellow-800/50 px-1 rounded">AddBlazouterInterop()</code> in Program.cs</span>
                </div>
            }
        </div>
    </div>

    <!-- Clipboard Section -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl mb-6 border border-gray-200 dark:border-gray-700">
        <div class="p-6">
            <h2 class="text-2xl font-bold mb-2 text-gray-900 dark:text-white">Clipboard Operations</h2>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                Copy and read text from the clipboard with permission handling
            </p>

            @if (_isInteropAvailable)
            {
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Text to Copy
                    </label>
                    <div class="flex gap-2">
                        <input type="text" 
                               @bind="_textToCopy" 
                               class="flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-teal-500 focus:border-transparent" 
                               placeholder="Enter text to copy" />
                        <button class="px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors whitespace-nowrap" 
                                @onclick="CopyToClipboard">
                            📋 Copy
                        </button>
                    </div>
                </div>

                <div class="mb-4">
                    <button class="px-4 py-2 bg-cyan-600 text-white rounded-lg hover:bg-cyan-700 transition-colors" 
                            @onclick="ReadFromClipboard">
                        📖 Read from Clipboard
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_clipboardContent))
                {
                    <div class="bg-cyan-50 dark:bg-cyan-900/20 border border-cyan-200 dark:border-cyan-800 rounded-lg p-4 mb-4">
                        <div class="text-sm font-medium text-cyan-800 dark:text-cyan-200 mb-1">Clipboard Content:</div>
                        <div class="text-sm text-cyan-700 dark:text-cyan-300 font-mono break-all">@_clipboardContent</div>
                    </div>
                }

                <div class="bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg p-4">
                    <div class="text-sm text-gray-700 dark:text-gray-300">
                        Clipboard API Supported: <strong>@(_isClipboardSupported ? "✅ Yes" : "❌ No")</strong>
                    </div>
                </div>
            }
            else
            {
                <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-600 dark:text-yellow-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span class="text-sm text-yellow-800 dark:text-yellow-200">Clipboard interop not available. Add <code class="bg-yellow-100 dark:bg-yellow-800/50 px-1 rounded">AddBlazouterInterop()</code> in Program.cs</span>
                </div>
            }
        </div>
    </div>

    <!-- Status Message -->
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="mb-6">
            <div class="@(_statusMessage.StartsWith("❌") ? "bg-red-50 dark:bg-red-900/20 border-red-200 dark:border-red-800 text-red-800 dark:text-red-200" : "bg-green-50 dark:bg-green-900/20 border-green-200 dark:border-green-800 text-green-800 dark:text-green-200") border rounded-lg p-4">
                @_statusMessage
            </div>
        </div>
    }

    <!-- Code Example Section -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700">
        <div class="p-6">
            <h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">How to Enable TypeScript Interop</h2>
            <div class="bg-gray-900 rounded-lg p-4 font-mono text-sm overflow-x-auto">
                <pre class="text-gray-400"><span class="text-gray-500">1</span> <span class="text-gray-400">// In Program.cs</span></pre>
                <pre class="text-gray-400"><span class="text-gray-500">2</span> <span class="text-blue-400">builder</span>.<span class="text-blue-400">Services</span>.<span class="text-green-400">AddBlazouter</span>();</pre>
                <pre class="text-gray-400"><span class="text-gray-500">3</span> <span class="text-blue-400">builder</span>.<span class="text-blue-400">Services</span>.<span class="text-green-400">AddBlazouterInterop</span>();</pre>
            </div>

            <a href="https://github.com/Taiizor/Blazouter/blob/develop/TYPESCRIPT_INTEGRATION.md" 
               target="_blank" 
               class="inline-block mt-4 px-4 py-2 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 underline transition-colors">
                📚 Read Full Documentation
            </a>
        </div>
    </div>

    <!-- Bottom anchor for scrolling -->
    <div id="page-bottom" class="mt-8"></div>
</div>