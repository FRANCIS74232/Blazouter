			<h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Protected Route</h1>
			<p class="text-xl text-green-600 dark:text-green-400 mb-2">✅ Access Granted</p>
			<p class="text-gray-600 dark:text-gray-400">
				This page is protected by a route guard. You successfully passed the authentication check!
			</p>
		</div>

		<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 mb-6 border border-gray-200 dark:border-gray-700">
			<h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">How Route Guards Work</h2>
			<p class="text-gray-600 dark:text-gray-400 mb-4">
				Route guards in Blazouter allow you to protect routes with custom authentication and authorization logic.
				They implement the <code class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded">IRouteGuard</code> interface.
			</p>
		</div>

		<div class="bg-gray-900 dark:bg-gray-950 rounded-xl shadow-lg overflow-hidden mb-6">
			<div class="px-4 py-2 bg-gray-800 dark:bg-gray-900 text-gray-300 text-sm font-semibold">
				AuthGuard.cs
			</div>
			<pre class="p-4 overflow-x-auto text-sm"><code class="text-gray-300">public class AuthGuard : IRouteGuard
{
    public async Task&lt;bool&gt; CanActivateAsync(RouteMatch match)
    {
        // Check authentication status
        return await IsAuthenticated();
    }

    public Task&lt;string?&gt; GetRedirectPathAsync(RouteMatch match)
    {
        return Task.FromResult&lt;string?&gt;("/login");
    }
}</code></pre>
		</div>

		<div class="bg-gray-900 dark:bg-gray-950 rounded-xl shadow-lg overflow-hidden">
			<div class="px-4 py-2 bg-gray-800 dark:bg-gray-900 text-gray-300 text-sm font-semibold">
				Route Configuration
			</div>
			<pre class="p-4 overflow-x-auto text-sm"><code class="text-gray-300">new RouteConfig
{
    Path = "/protected",
    Component = typeof(Protected),
    Guards = new List&lt;Type&gt; { typeof(AuthGuard) }
}</code></pre>
		</div>
	</div>
